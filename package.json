{
  "name": "timer-overlay",
  "version": "1.0.0",
  "description": "Windows 11 overlay: red circle moving along the right edge, click-through",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ],
        "testEnvironment": "node"
      },
      {
        "displayName": "integration",
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.js"
        ],
        "testEnvironment": "node"
      }
    ],
    "testTimeout": 20000
  }
}


