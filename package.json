{
  "name": "timer-overlay",
  "version": "1.0.0",
  "description": "It's time! - новый подход к продуктивности. Напоминание о том, что каждая минута имеет значение. Windows productivity tool.",
  "main": "main.js",
  "type": "commonjs",
  "bin": {
    "timer-overlay": "./main.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "dist": "electron-builder --publish=never",
    "make-exe": "npm run build:portable"
  },
  "keywords": [
    "productivity",
    "timer",
    "overlay",
    "memento-mori",
    "time-management",
    "windows",
    "electron",
    "widget",
    "reminder",
    "focus"
  ],
  "author": "cynepnaxa2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cynepnaxa2/its-time.git"
  },
  "homepage": "https://github.com/cynepnaxa2/its-time#readme",
  "bugs": {
    "url": "https://github.com/cynepnaxa2/its-time/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "main.js",
    "index.html",
    "settings.html",
    "preload/",
    "src/",
    "assets/",
    "package.json",
    "README.md"
  ],
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.0.12",
    "jest": "^29.7.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ],
        "testEnvironment": "node"
      },
      {
        "displayName": "integration",
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.js"
        ],
        "testEnvironment": "node"
      }
    ],
    "testTimeout": 20000
  },
  "build": {
    "appId": "com.timeroverlay.app",
    "productName": "Its-time",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "settings.html",
      "preload/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "forceCodeSigning": false
    },
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [],
    "extraMetadata": {
      "main": "main.js"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "its-time-portable.exe"
    }
  }
}
