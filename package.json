{
  "name": "timer-overlay",
  "version": "1.0.0",
  "description": "It's time! - новый подход к продуктивности. Напоминание о том, что каждая минута имеет значение. Windows productivity tool.",
  "main": "main.js",
  "type": "commonjs",
  "bin": {
    "timer-overlay": "./main.js"
  },
  "scripts": {
    "start": "npm run electron:dev",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder"
  },
  "keywords": [
    "productivity",
    "timer",
    "overlay",
    "memento-mori",
    "time-management",
    "windows",
    "electron",
    "widget",
    "reminder",
    "focus"
  ],
  "author": "cynepnaxa2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cynepnaxa2/its-time.git"
  },
  "homepage": "https://github.com/cynepnaxa2/its-time#readme",
  "bugs": {
    "url": "https://github.com/cynepnaxa2/its-time/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "main.js",
    "index.html",
    "settings.html",
    "preload/",
    "src/",
    "assets/",
    "package.json",
    "README.md"
  ],
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "electron": "^31.0.0",
    "electron-builder": "^26.0.12",
    "jest": "^29.7.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.17"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ],
        "testEnvironment": "node"
      },
      {
        "displayName": "integration",
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.js"
        ],
        "testEnvironment": "node"
      }
    ],
    "testTimeout": 20000
  },
  "build": {
    "appId": "com.timeroverlay.app",
    "productName": "Its-time",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "settings.html",
      "todo.html",
      "preload/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false
    },
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [],
    "extraMetadata": {
      "main": "main.js"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.1.18",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.10"
  }
}
